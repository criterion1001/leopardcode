WEB_SEARCH_API=
LEOPARDCODE_BACKEND_URL=

# Comma-separated browser origins allowed to open the Socket.IO connection.
# Unset (or "*") allows any origin, which is fine for the demo.
WEB_ALLOWED_ORIGINS=

# Model 6 (DeepSeek Flash) is funded by the operator for the web workspace: the
# backend uses this key whenever a web client selects model 6, and never sends it
# to clients. The CLI does not offer model 6.
PROVIDED_MODEL_KEY=

# OCI Object Storage (API-key auth, all from env).
OCI_TENANCY=
OCI_USER=
OCI_FINGERPRINT=
OCI_REGION=
# Private key: a mounted PEM path, or inline PEM with \n escapes.
OCI_KEY_FILE=
OCI_KEY_CONTENT=
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_NAMESPACE=
OCI_BUCKET=

# Sponsor integrations (backend/sponsor/, CI guard in .github/workflows/sponsor-smoke.yml).
# Fill values in your local env or GitHub Actions secrets - never commit them.
# NVIDIA NIM key for Nemotron, from build.nvidia.com.
NVIDIA_API_KEY=
# Optional override; defaults to https://integrate.api.nvidia.com/v1
NIM_BASE_URL=
# Meterless local hotspot; defaults to http://127.0.0.1:8088/v1.
# Runtime token lives in <stateDir>/proxy-token (key: meterless_runtime_token).
METERLESS_BASE_URL=
METERLESS_TOKEN=
# Stable lowercase client id sent as the meterless-app header; defaults to leopardcode.
METERLESS_APP_ID=
# Zetaris documented REST API; defaults to http://localhost:8888/api/v1.0
# (see zetaris/getting-started scripts/run_sql.py for the contract).
ZETARIS_REST_URL=
ZETARIS_API_KEY=
# Numeric org id sent as X-Org-ID; defaults to 1
ZETARIS_ORG_ID=
